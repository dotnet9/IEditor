<UserControl
    x:Class="IEditor.App.Views.BatchProcessingView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:icons="using:IEditor.App.Icons"
    xmlns:vm="using:IEditor.App.ViewModels"
    x:CompileBindings="True"
    x:DataType="vm:BatchProcessingViewModel"
    >
  <Grid RowDefinitions="52,*,34">

    <!-- 顶栏 -->
    <Border Classes="ie-topbar">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="12">
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <TextBlock Classes="ie-crumb" Text="工作台 /" />
          <TextBlock Classes="ie-crumb-current" Text="{Binding Title}" />
        </StackPanel>
        <Border Grid.Column="1" Classes="ie-chip chip-amber">
          <TextBlock Text="{Binding PageStatusBadge}" />
        </Border>
      </Grid>
    </Border>

    <!-- 内容 -->
    <Border Grid.Row="1" Background="{DynamicResource IEditorDotGridBrush}">
      <Grid ColumnDefinitions="*,320" ColumnSpacing="16" Margin="20">

        <!-- 左列 -->
        <StackPanel Spacing="14">
          <!-- 导入区 -->
          <Border Classes="ie-card" Padding="22">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16" VerticalAlignment="Center">
              <Border
                  Width="46"
                  Height="46"
                  CornerRadius="14"
                  Background="{DynamicResource IEditorAccentSoftBrush}">
                <Path Classes="ie-icon" Width="22" Height="22" Data="{x:Static icons:AppIcons.Add}" Stroke="{DynamicResource IEditorAccentBrush}" />
              </Border>
              <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                <TextBlock FontSize="13.5" FontWeight="SemiBold" Text="{Binding DropTitleText}" />
                <TextBlock Classes="ie-muted" Text="{Binding DropDescriptionText}" />
              </StackPanel>
              <Button Grid.Column="2" Classes="ie-secondary-button" VerticalAlignment="Center" Click="OnAddImagesClick">
                <TextBlock Text="{Binding AddImageText}" />
              </Button>
            </Grid>
          </Border>

          <!-- 处理队列 -->
          <Border Classes="ie-card">
            <Grid RowDefinitions="Auto,Auto,*,Auto">
              <Border Classes="ie-card-header">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Path Classes="ie-icon" Width="15" Height="15" Data="{x:Static icons:AppIcons.BatchProcessing}" Stroke="{DynamicResource IEditorAccentBrush}" />
                    <TextBlock Classes="ie-section-title" Text="{Binding QueueTitleText}" />
                  </StackPanel>
                  <TextBlock Grid.Column="2" Classes="ie-footnote" Text="{Binding QueueHintText}" />
                </Grid>
              </Border>

              <!-- 表头 -->
              <Border Grid.Row="1" Padding="12,10" BorderBrush="{DynamicResource IEditorBorderBrush}" BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="36,*,92,100,150,52" ColumnSpacing="12">
                  <CheckBox
                      HorizontalAlignment="Center"
                      IsChecked="{Binding AreAllItemsSelected, Mode=TwoWay}"
                      VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Classes="ie-footnote" Text="{Binding FileColumnText}" />
                  <TextBlock Grid.Column="2" Classes="ie-footnote" Text="{Binding SizeColumnText}" />
                  <TextBlock Grid.Column="3" Classes="ie-footnote" Text="{Binding BackgroundColumnText}" />
                  <TextBlock Grid.Column="4" Classes="ie-footnote" Text="{Binding StatusColumnText}" />
                </Grid>
              </Border>

              <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding QueueItems}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:BatchProcessingItemViewModel">
                      <Border Classes="ie-table-row">
                        <Grid ColumnDefinitions="36,*,92,100,150,52" ColumnSpacing="12" VerticalAlignment="Center">
                          <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" />
                          <Grid Grid.Column="1" ColumnDefinitions="44,*" ColumnSpacing="10">
                            <Border
                                Width="44"
                                Height="56"
                                CornerRadius="8"
                                ClipToBounds="True"
                                Background="{Binding ThumbnailBrush}"
                                BorderBrush="{DynamicResource IEditorBorderBrush}"
                                BorderThickness="1">
                              <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                              <TextBlock FontSize="12.5" FontWeight="SemiBold" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
                              <TextBlock Classes="ie-mono" Foreground="{DynamicResource IEditorTextTertiaryBrush}" Text="{Binding FileInfo}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                          </Grid>
                          <Border Grid.Column="2" Classes="ie-chip chip-blue" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SizeText}" />
                          </Border>
                          <Border Grid.Column="3" Classes="ie-chip" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <Ellipse Width="10" Height="10" Fill="{Binding ThumbnailBrush}" Stroke="{DynamicResource IEditorBorderStrongBrush}" StrokeThickness="1" />
                              <TextBlock Text="{Binding BackgroundText}" />
                            </StackPanel>
                          </Border>
                          <StackPanel Grid.Column="4" VerticalAlignment="Center" Spacing="5">
                            <Border
                                Classes="ie-chip"
                                Classes.chip-green="{Binding IsCompleted}"
                                Classes.chip-blue="{Binding IsProcessing}"
                                Classes.chip-danger="{Binding IsFailed}">
                              <TextBlock Text="{Binding StatusText}" />
                            </Border>
                            <ProgressBar
                                Classes="ie-progress"
                                Minimum="0"
                                Maximum="1"
                                Value="{Binding Progress}"
                                IsVisible="{Binding IsProcessing}" />
                          </StackPanel>
                          <Button Grid.Column="5" Classes="ie-icon-button" VerticalAlignment="Center">
                            <Path Classes="ie-icon" Width="15" Height="15" Data="{x:Static icons:AppIcons.Menu}" Stroke="{Binding $parent[Button].Foreground}" />
                          </Button>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>

              <!-- 批量操作条 -->
              <Border Grid.Row="3" Classes="ie-batch-bar">
                <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                  <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource IEditorTextSecondaryBrush}" Text="{Binding SelectedCountText}" />
                  <Button Grid.Column="1" Classes="ie-secondary-button" Height="28" FontSize="12" Command="{Binding SelectSizeCommand}" CommandParameter="{Binding SelectedSizeOption}">
                    <TextBlock Text="{Binding UniformSizeText}" />
                  </Button>
                  <Button Grid.Column="2" Classes="ie-secondary-button" Height="28" FontSize="12" Command="{Binding SelectBackgroundCommand}" CommandParameter="{Binding SelectedBackgroundOption}">
                    <TextBlock Text="{Binding UniformBackgroundText}" />
                  </Button>
                  <Button Grid.Column="3" Classes="ie-secondary-button" Height="28" FontSize="12" Command="{Binding RemoveSelectedCommand}">
                    <TextBlock Text="{Binding RemoveText}" />
                  </Button>
                </Grid>
              </Border>
            </Grid>
          </Border>
        </StackPanel>

        <!-- 右列 -->
        <StackPanel Grid.Column="1" Spacing="14">
          <!-- 统一尺寸 -->
          <Border Classes="ie-card">
            <StackPanel>
              <Border Classes="ie-card-header">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Path Classes="ie-icon" Width="15" Height="15" Data="{x:Static icons:AppIcons.Crop}" Stroke="{DynamicResource IEditorAccentBrush}" />
                  <TextBlock Classes="ie-section-title" Text="{Binding SizeSectionTitleText}" />
                  <TextBlock Classes="ie-footnote" Margin="4,0,0,0" VerticalAlignment="Center" Text="{Binding SizeSectionHintText}" />
                </StackPanel>
              </Border>
              <Border Classes="ie-card-body">
                <StackPanel Spacing="12">
                  <ItemsControl ItemsSource="{Binding SizeOptions}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <UniformGrid Columns="2" Rows="2" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:BatchSizeOptionViewModel">
                        <ToggleButton
                            Classes="ie-spec-card"
                            Margin="0,5,5,0"
                            IsChecked="{Binding IsSelected, Mode=TwoWay}"
                            Command="{Binding $parent[ItemsControl].((vm:BatchProcessingViewModel)DataContext).SelectSizeCommand}"
                            CommandParameter="{Binding}">
                          <StackPanel>
                            <TextBlock Classes="title" Text="{Binding Title}" />
                            <TextBlock Classes="sub" Text="{Binding SubLabel}" />
                          </StackPanel>
                        </ToggleButton>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Border
                      Background="{DynamicResource IEditorSurface2Brush}"
                      BorderBrush="{DynamicResource IEditorBorderStrongBrush}"
                      BorderThickness="1"
                      CornerRadius="10"
                      Padding="12,8">
                    <TextBlock
                        Classes="ie-mono"
                        Foreground="{DynamicResource IEditorTextSecondaryBrush}"
                        Text="{Binding SizeSummaryText}"
                        TextTrimming="CharacterEllipsis" />
                  </Border>
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>

          <!-- 统一背景 -->
          <Border Classes="ie-card">
            <StackPanel>
              <Border Classes="ie-card-header">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Path Classes="ie-icon" Width="15" Height="15" Data="{x:Static icons:AppIcons.Palette}" Stroke="{DynamicResource IEditorAccentBrush}" />
                  <TextBlock Classes="ie-section-title" Text="{Binding UniformBackgroundText}" />
                </StackPanel>
              </Border>
              <Border Classes="ie-card-body">
                <StackPanel Spacing="12">
                  <ItemsControl ItemsSource="{Binding BackgroundOptions}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="10" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:BackgroundOptionViewModel">
                        <ToggleButton
                            Classes="ie-swatch"
                            Classes.rainbow="{Binding IsCustom}"
                            Background="{Binding AvaloniaBrush}"
                            IsChecked="{Binding IsSelected, Mode=TwoWay}"
                            Command="{Binding $parent[ItemsControl].((vm:BatchProcessingViewModel)DataContext).SelectBackgroundCommand}"
                            CommandParameter="{Binding}"
                            ToolTip.Tip="{Binding Title}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <StackPanel Spacing="6">
                    <TextBlock Classes="ie-muted" Text="{Binding FilenameTemplateLabelText}" />
                    <TextBox CornerRadius="10" Text="{Binding FilenameTemplate, Mode=TwoWay}" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Border Classes="ie-chip"><TextBlock Text="{Binding TokenNameText}" /></Border>
                    <Border Classes="ie-chip"><TextBlock Text="{Binding TokenSizeText}" /></Border>
                    <Border Classes="ie-chip"><TextBlock Text="{Binding TokenColorText}" /></Border>
                    <Border Classes="ie-chip"><TextBlock Text="{Binding TokenDateText}" /></Border>
                    <Border Classes="ie-chip"><TextBlock Text="{Binding TokenIndexText}" /></Border>
                  </StackPanel>
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>

          <!-- 高级选项 -->
          <Border Classes="ie-card">
            <StackPanel>
              <Border Classes="ie-card-header">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Path Classes="ie-icon" Width="15" Height="15" Data="{x:Static icons:AppIcons.Zap}" Stroke="{DynamicResource IEditorAccentBrush}" />
                  <TextBlock Classes="ie-section-title" Text="{Binding AdvancedOptionsTitleText}" />
                </StackPanel>
              </Border>
              <Border Classes="ie-row">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                  <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Classes="ie-row-title" Text="{Binding ConcurrencyLabelText}" />
                    <TextBlock Classes="ie-footnote" Text="{Binding ConcurrencyDescriptionText}" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                    <Button Classes="ie-seg-opt" Classes.on="{Binding IsConcurrency2}" Command="{Binding SetConcurrencyCommand}" CommandParameter="2" Content="2" />
                    <Button Classes="ie-seg-opt" Classes.on="{Binding IsConcurrency4}" Command="{Binding SetConcurrencyCommand}" CommandParameter="4" Content="4" />
                    <Button Classes="ie-seg-opt" Classes.on="{Binding IsConcurrency8}" Command="{Binding SetConcurrencyCommand}" CommandParameter="8" Content="8" />
                  </StackPanel>
                </Grid>
              </Border>
              <Border Classes="ie-row">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                  <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Classes="ie-row-title" Text="{Binding SkipProcessedLabelText}" />
                    <TextBlock Classes="ie-footnote" Text="{Binding SkipProcessedDescriptionText}" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1" IsChecked="{Binding SkipProcessed, Mode=TwoWay}" />
                </Grid>
              </Border>
              <Border Classes="ie-row">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                  <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Classes="ie-row-title" Text="{Binding OpenFolderWhenDoneLabelText}" />
                    <TextBlock Classes="ie-footnote" Text="{Binding OpenFolderWhenDoneDescriptionText}" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1" IsChecked="{Binding OpenFolderWhenDone, Mode=TwoWay}" />
                </Grid>
              </Border>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </Border>

    <!-- 状态栏 -->
    <Border Grid.Row="2" Classes="ie-statusbar">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="16">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Ellipse Classes="ie-dot" Classes.busy="{Binding IsBusy}" />
          <TextBlock FontSize="12" Foreground="{DynamicResource IEditorTextSecondaryBrush}" Text="{Binding FooterStatusText}" />
        </StackPanel>
        <TextBlock Grid.Column="2" VerticalAlignment="Center" Classes="ie-footnote" Text="{Binding QueueSummaryText}" />
        <TextBlock Grid.Column="3" VerticalAlignment="Center" Classes="ie-footnote" Text="{Binding Concurrency, StringFormat=并发 {0}}" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
