<UserControl
    x:Class="IEditor.App.Views.PhotoStudioView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cp="using:Avalonia.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:icons="using:IEditor.App.Icons"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shapes="using:Avalonia.Controls.Shapes"
    xmlns:u="using:Ursa.Controls"
    xmlns:vm="using:IEditor.App.ViewModels"
    x:CompileBindings="True"
    x:DataType="vm:PhotoStudioViewModel"
    d:DesignHeight="860"
    d:DesignWidth="1320"
    mc:Ignorable="d">
  <Grid RowDefinitions="Auto,*,Auto" RowSpacing="16" Margin="16">
    <Border
        Background="{DynamicResource IEditorSurfaceBrush}"
        BorderBrush="{DynamicResource IEditorBorderBrush}"
        BorderThickness="1"
        CornerRadius="8"
        Padding="12,10">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
        <StackPanel Spacing="2">
          <TextBlock Classes="ie-section-title" Text="{Binding Breadcrumb}" />
          <TextBlock Classes="ie-footnote" Text="{Binding Subtitle}" />
        </StackPanel>
        <Border
            Grid.Column="1"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Padding="10,4"
            Background="{DynamicResource IEditorAccentSoftBrush}"
            BorderBrush="{DynamicResource IEditorAccentTintBrush}"
            BorderThickness="1"
            CornerRadius="999">
          <TextBlock Classes="ie-footnote" Foreground="{DynamicResource IEditorAccentBrush}" Text="{Binding PageStatusBadge}" />
        </Border>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
          <Button Classes="ie-icon-button" Command="{Binding HelpCommand}" ToolTip.Tip="{Binding HelpText}">
            <shapes:Path Width="15" Height="15" Data="{x:Static icons:AppIcons.Help}" Fill="{DynamicResource IEditorTextSecondaryBrush}" />
          </Button>
          <Button Classes="ie-icon-button" Command="{Binding ToggleThemeCommand}" ToolTip.Tip="{Binding ThemeSwitchText}">
            <shapes:Path Width="15" Height="15" Data="{x:Static icons:AppIcons.Theme}" Fill="{DynamicResource IEditorTextSecondaryBrush}" />
          </Button>
          <Button Classes="ie-primary-button" Command="{Binding SaveCommand}">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <shapes:Path Width="15" Height="15" Data="{x:Static icons:AppIcons.Export}" Fill="White" />
              <TextBlock Text="{Binding ExportImageText}" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="54,*,332" ColumnSpacing="16">
      <Border
          Background="{DynamicResource IEditorSurfaceBrush}"
          BorderBrush="{DynamicResource IEditorBorderBrush}"
          BorderThickness="1"
          CornerRadius="8"
          Padding="8">
        <StackPanel HorizontalAlignment="Center" Spacing="6">
          <Button Classes="ie-icon-button" Command="{Binding ActivateToolCommand}" CommandParameter="{x:Static vm:PhotoStudioTool.LoadImage}" ToolTip.Tip="{Binding LoadImageText}">
            <shapes:Path Width="15" Height="15" Data="{x:Static icons:AppIcons.LoadImage}" Fill="{DynamicResource IEditorTextSecondaryBrush}" />
          </Button>
          <Border Width="24" Height="1" Background="{DynamicResource IEditorBorderBrush}" />
          <Button Classes="ie-icon-button" Command="{Binding ActivateToolCommand}" CommandParameter="{x:Static vm:PhotoStudioTool.Crop}" ToolTip.Tip="{Binding CropText}">
            <shapes:Path Width="15" Height="15" Data="{x:Static icons:AppIcons.Crop}" Fill="{DynamicResource IEditorTextSecondaryBrush}" />
          </Button>
          <Button Classes="ie-icon-button" Command="{Binding ActivateToolCommand}" CommandParameter="{x:Static vm:PhotoStudioTool.RotateLeft}" ToolTip.Tip="{Binding RotateLeftText}">
            <shapes:Path Width="15" Height="15" Data="{x:Static icons:AppIcons.RotateLeft}" Fill="{DynamicResource IEditorTextSecondaryBrush}" />
          </Button>
          <Button Classes="ie-icon-button" Command="{Binding ActivateToolCommand}" CommandParameter="{x:Static vm:PhotoStudioTool.RotateRight}" ToolTip.Tip="{Binding RotateRightText}">
            <shapes:Path Width="15" Height="15" Data="{x:Static icons:AppIcons.RotateRight}" Fill="{DynamicResource IEditorTextSecondaryBrush}" />
          </Button>
          <Button Classes="ie-icon-button" Command="{Binding ActivateToolCommand}" CommandParameter="{x:Static vm:PhotoStudioTool.FlipHorizontal}" ToolTip.Tip="{Binding FlipHorizontalText}">
            <shapes:Path Width="15" Height="15" Data="{x:Static icons:AppIcons.FlipHorizontal}" Fill="{DynamicResource IEditorTextSecondaryBrush}" />
          </Button>
          <Border Width="24" Height="1" Background="{DynamicResource IEditorBorderBrush}" />
          <Button Classes="ie-icon-button" Command="{Binding ActivateToolCommand}" CommandParameter="{x:Static vm:PhotoStudioTool.Reset}" ToolTip.Tip="{Binding ResetViewText}">
            <shapes:Path Width="15" Height="15" Data="{x:Static icons:AppIcons.Refresh}" Fill="{DynamicResource IEditorTextSecondaryBrush}" />
          </Button>
        </StackPanel>
      </Border>

      <StackPanel Spacing="12">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Border Background="{DynamicResource IEditorSurfaceBrush}" BorderBrush="{DynamicResource IEditorBorderBrush}" BorderThickness="1" CornerRadius="10">
            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto" VerticalAlignment="Center">
              <Button Classes="ie-icon-button" Command="{Binding SetZoomCommand}" CommandParameter="-" ToolTip.Tip="{Binding PreviewZoomText}">
                <TextBlock FontSize="15" Text="-" />
              </Button>
              <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="8,0" FontFamily="Consolas" Text="{Binding PreviewZoomText}" />
              <Button Grid.Column="2" Classes="ie-icon-button" Command="{Binding SetZoomCommand}" CommandParameter="+" ToolTip.Tip="{Binding PreviewZoomText}">
                <TextBlock FontSize="15" Text="+" />
              </Button>
              <Button Grid.Column="3" Classes="ie-icon-button" Command="{Binding SetZoomCommand}" CommandParameter="fit" ToolTip.Tip="{Binding FitToWindowText}">
                <shapes:Path Width="14" Height="14" Data="{x:Static icons:AppIcons.Fit}" Fill="{DynamicResource IEditorTextSecondaryBrush}" />
              </Button>
            </Grid>
          </Border>
          <Button
              Classes="ie-ghost-button"
              Command="{Binding ToggleGuidesCommand}"
              ToolTip.Tip="{Binding GuidesText}">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <shapes:Path Width="14" Height="14" Data="{x:Static icons:AppIcons.Guides}" Fill="{DynamicResource IEditorTextSecondaryBrush}" />
              <TextBlock Text="{Binding GuidesText}" />
            </StackPanel>
          </Button>
          <Button
              Classes="ie-ghost-button"
              Command="{Binding ToggleCompareCommand}"
              ToolTip.Tip="{Binding CompareOriginalText}">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <shapes:Path Width="14" Height="14" Data="{x:Static icons:AppIcons.Compare}" Fill="{DynamicResource IEditorTextSecondaryBrush}" />
              <TextBlock Text="{Binding CompareOriginalText}" />
            </StackPanel>
          </Button>
          <Border Background="{DynamicResource IEditorAccentSoftBrush}" BorderBrush="{DynamicResource IEditorAccentTintBrush}" BorderThickness="1" CornerRadius="999" Padding="10,4">
            <TextBlock Classes="ie-footnote" Foreground="{DynamicResource IEditorAccentBrush}" Text="{Binding EngineReady}" />
          </Border>
        </StackPanel>

        <Border
            Background="{DynamicResource IEditorSurfaceBrush}"
            BorderBrush="{DynamicResource IEditorBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            MinHeight="600"
            Padding="16">
          <Grid>
            <Border
                Background="{DynamicResource IEditorSurface2Brush}"
                BorderBrush="{DynamicResource IEditorBorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
              <StackPanel Spacing="10" HorizontalAlignment="Center">
                <u:ImageViewer Source="{Binding DisplayedPreviewBitmap}" Width="300" Height="400" />
                <TextBlock Classes="ie-footnote" HorizontalAlignment="Center" Text="{Binding ProcessingSummary}" />
                <TextBlock Classes="ie-footnote" HorizontalAlignment="Center" Text="{Binding BackgroundSummary}" />
              </StackPanel>
            </Border>
          </Grid>
        </Border>
      </StackPanel>

      <StackPanel Spacing="14">
        <Border Classes="ie-surface-card" Padding="0">
          <Grid RowDefinitions="Auto,*">
            <Border Padding="14,12" BorderBrush="{DynamicResource IEditorBorderBrush}" BorderThickness="0,0,0,1">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <shapes:Path Width="15" Height="15" Data="{x:Static icons:AppIcons.PhotoStudio}" Fill="{DynamicResource IEditorAccentBrush}" />
                <TextBlock Classes="ie-section-title" Text="{Binding SourceSectionTitle}" />
                <TextBlock Classes="ie-footnote" Text="{Binding SourceSectionHint}" />
              </StackPanel>
            </Border>
            <StackPanel Grid.Row="1" Spacing="10" Margin="14">
              <u:PathPicker
                  AllowMultiple="False"
                  Command="{Binding OpenSourceCommand}"
                  DefaultFileExtension="jpg"
                  FileFilter="[ImageAll]"
                  SelectedPathsText="{Binding SourcePath, Mode=TwoWay}"
                  SuggestedStartPath="{Binding InputSuggestedStartPath}"
                  UsePickerType="OpenFile" />
              <TextBlock Classes="ie-muted" Text="{Binding SourceSummary}" />
            </StackPanel>
          </Grid>
        </Border>

        <Border Classes="ie-surface-card" Padding="0">
          <Grid RowDefinitions="Auto,*">
            <Border Padding="14,12" BorderBrush="{DynamicResource IEditorBorderBrush}" BorderThickness="0,0,0,1">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <shapes:Path Width="15" Height="15" Data="{x:Static icons:AppIcons.Crop}" Fill="{DynamicResource IEditorAccentBrush}" />
                <TextBlock Classes="ie-section-title" Text="{Binding SizeSectionTitle}" />
                <TextBlock Classes="ie-footnote" Text="{Binding SizeSectionHint}" />
              </StackPanel>
            </Border>
            <StackPanel Grid.Row="1" Spacing="10" Margin="14">
              <ComboBox ItemsSource="{Binding SizeOptions}" SelectedItem="{Binding SelectedSizeOption, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:PhotoSizeOptionViewModel">
                    <StackPanel>
                      <TextBlock Text="{Binding Title}" />
                      <TextBlock Classes="ie-footnote" Text="{Binding Token}" />
                    </StackPanel>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <u:NumericDoubleUpDown
                    InnerLeftContent="{Binding WidthMmText}"
                    IsEnabled="{Binding IsCustomSize}"
                    Value="{Binding WidthMm, Mode=TwoWay}" />
                <u:NumericDoubleUpDown
                    Grid.Column="1"
                    InnerLeftContent="{Binding HeightMmText}"
                    IsEnabled="{Binding IsCustomSize}"
                    Value="{Binding HeightMm, Mode=TwoWay}" />
              </Grid>
              <u:NumericIntUpDown InnerLeftContent="{Binding DpiText}" Minimum="72" Step="10" Value="{Binding Dpi, Mode=TwoWay}" />
            </StackPanel>
          </Grid>
        </Border>

        <Border Classes="ie-surface-card" Padding="0">
          <Grid RowDefinitions="Auto,*">
            <Border Padding="14,12" BorderBrush="{DynamicResource IEditorBorderBrush}" BorderThickness="0,0,0,1">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <shapes:Path Width="15" Height="15" Data="{x:Static icons:AppIcons.Guides}" Fill="{DynamicResource IEditorAccentBrush}" />
                <TextBlock Classes="ie-section-title" Text="{Binding BackgroundSectionTitle}" />
                <TextBlock Classes="ie-footnote" Text="{Binding BackgroundSectionHint}" />
              </StackPanel>
            </Border>
            <StackPanel Grid.Row="1" Spacing="10" Margin="14">
              <ComboBox ItemsSource="{Binding BackgroundOptions}" SelectedItem="{Binding SelectedBackgroundOption, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:BackgroundOptionViewModel">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Border Width="14" Height="14" CornerRadius="999" Background="{Binding AvaloniaColor}" BorderBrush="{DynamicResource IEditorBorderBrush}" BorderThickness="1" />
                      <StackPanel>
                        <TextBlock Text="{Binding Title}" />
                        <TextBlock Classes="ie-footnote" Text="{Binding Token}" />
                      </StackPanel>
                    </StackPanel>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <cp:ColorView
                  Height="220"
                  IsAccentColorsVisible="False"
                  IsAlphaEnabled="False"
                  IsAlphaVisible="False"
                  IsColorComponentsVisible="False"
                  IsColorModelVisible="False"
                  IsColorPaletteVisible="False"
                  IsColorSpectrumSliderVisible="False"
                  IsComponentSliderVisible="False"
                  IsComponentTextInputVisible="False"
                  IsHexInputVisible="True"
                  IsVisible="{Binding IsCustomBackground}"
                  Color="{Binding CustomBackgroundColor, Mode=TwoWay}" />
            </StackPanel>
          </Grid>
        </Border>

        <Border Classes="ie-surface-card" Padding="0">
          <Grid RowDefinitions="Auto,*">
            <Border Padding="14,12" BorderBrush="{DynamicResource IEditorBorderBrush}" BorderThickness="0,0,0,1">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <shapes:Path Width="15" Height="15" Data="{x:Static icons:AppIcons.Export}" Fill="{DynamicResource IEditorAccentBrush}" />
                <TextBlock Classes="ie-section-title" Text="{Binding OutputSectionTitle}" />
                <TextBlock Classes="ie-footnote" Text="{Binding OutputSectionHint}" />
              </StackPanel>
            </Border>
            <StackPanel Grid.Row="1" Spacing="10" Margin="14">
              <ComboBox ItemsSource="{Binding FormatOptions}" SelectedItem="{Binding SelectedFormatOption, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:FormatOptionViewModel">
                    <TextBlock Text="{Binding Title}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <StackPanel Spacing="4">
                <TextBlock Classes="ie-footnote" Text="{Binding OutputQualityText}" />
                <Slider Maximum="100" Minimum="60" Value="{Binding OutputQuality, Mode=TwoWay}" />
              </StackPanel>
              <u:PathPicker
                  AllowMultiple="False"
                  DefaultFileExtension="jpg"
                  FileFilter="[ImageJpg][ImagePng]"
                  SelectedPathsText="{Binding OutputPath, Mode=TwoWay}"
                  SuggestedFileName="{Binding SuggestedOutputFileName}"
                  SuggestedStartPath="{Binding OutputSuggestedStartPath}"
                  UsePickerType="SaveFile" />
              <TextBox Text="{Binding FilenameTemplate, Mode=TwoWay}" />
            </StackPanel>
          </Grid>
        </Border>

        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Classes="ie-primary-button" Command="{Binding SaveCommand}">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <shapes:Path Width="15" Height="15" Data="{x:Static icons:AppIcons.Export}" Fill="White" />
              <TextBlock Text="{Binding SaveExportText}" />
            </StackPanel>
          </Button>
          <Button Classes="ie-secondary-button" Command="{Binding GeneratePreviewCommand}">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <shapes:Path Width="14" Height="14" Data="{x:Static icons:AppIcons.Preview}" Fill="{DynamicResource IEditorTextSecondaryBrush}" />
              <TextBlock Text="{Binding LoadImageText}" />
            </StackPanel>
          </Button>
          <Button Classes="ie-secondary-button" Command="{Binding ResetCommand}">
            <TextBlock Text="{Binding ResetViewText}" />
          </Button>
        </StackPanel>
      </StackPanel>
    </Grid>

    <Border
        Grid.Row="2"
        Background="{DynamicResource IEditorSurfaceBrush}"
        BorderBrush="{DynamicResource IEditorBorderBrush}"
        BorderThickness="1"
        CornerRadius="8"
        Padding="12,8">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="14">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Classes="ie-footnote" Text="{Binding PageStatusBadge}" />
          <TextBlock Classes="ie-footnote" Text="·" />
          <TextBlock Classes="ie-footnote" Text="{Binding PreviewZoomText}" />
        </StackPanel>
        <TextBlock Grid.Column="1" Classes="ie-footnote" Text="{Binding ProcessingSummary}" />
        <TextBlock Grid.Column="3" Classes="ie-footnote" Text="{Binding BackgroundSummary}" />
        <TextBlock Grid.Column="4" Classes="ie-footnote" Text="{Binding ProcessingEngineText}" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
