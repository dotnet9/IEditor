<codewf:CodeWFWindow
    x:Class="IEditor.App.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lcommon="using:Localization.Common"
    xmlns:lshell="using:Localization.Shell"
    xmlns:lphotostudio="using:Localization.PhotoStudio"
    xmlns:lsettings="using:Localization.Settings"
    xmlns:lbatch="using:Localization.Batch"
    xmlns:labout="using:Localization.About"
    xmlns:codewf="https://codewf.com"
    xmlns:helpers="using:IEditor.App.Helpers"
    xmlns:dialogViews="using:IEditor.App.Views.Dialogs"
    xmlns:dialogVm="using:IEditor.App.ViewModels.Dialogs"
    xmlns:vm="using:IEditor.App.ViewModels"
    xmlns:views="using:IEditor.App.Views"
    xmlns:u="https://irihi.tech/ursa"
    x:CompileBindings="True"
    x:DataType="vm:MainViewModel"
    Background="{DynamicResource StudioBackground}"
    FontFamily="Microsoft YaHei UI, Microsoft YaHei, Segoe UI"
    Height="860"
    Icon="/Assets/logo.ico"
    MinHeight="760"
    MinWidth="1100"
    Title="{Binding WindowTitle}"
    Width="1320"
    TitleBarHeight="42"
    TitleBarBackground="{DynamicResource StudioBackground}"
    TitleBarForeground="{DynamicResource StudioText}"
    Foreground="{DynamicResource StudioText}"
    TitleBarBorderBrush="{DynamicResource StudioGradient}"
    TitleBarBorderThickness="0,0,0,3"
    WindowStartupLocation="CenterScreen">
  <codewf:CodeWFWindow.LeftContent>
    <!-- 自定义标题栏（品牌区） -->
    <StackPanel
        Margin="10,0,0,0"
        Orientation="Horizontal"
        Spacing="10"
        VerticalAlignment="Center">
      <Image
          Width="34"
          Height="34"
          Source="/Assets/logo.png" />
      <StackPanel VerticalAlignment="Center" Spacing="1">
        <TextBlock FontSize="15" FontWeight="Bold" Text="{Binding WindowTitle}" />
        <TextBlock
            Classes="ie-footnote"
            FontSize="11"
            Text="{Binding BrandSubtitle}" />
      </StackPanel>
    </StackPanel>
  </codewf:CodeWFWindow.LeftContent>
  <codewf:CodeWFWindow.RightContent>
    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,12,0" VerticalAlignment="Center">
      <ThemeVariantScope x:Name="TitleBarThemeScope" RequestedThemeVariant="{Binding SettingsPage.ThemeMode, Mode=TwoWay, Converter={x:Static codewf:StudioThemeModeConverter.Instance}}">
        <ThemeVariantScope.Resources>
          <TextBlock x:Key="STRING_THEME_TOGGLE_SYSTEM" Text="{codewf:I18n {x:Static lcommon:Theme.System}}" />
          <TextBlock x:Key="STRING_THEME_TOGGLE_LIGHT" Text="{codewf:I18n {x:Static lcommon:Theme.Light}}" />
          <TextBlock x:Key="STRING_THEME_TOGGLE_DARK" Text="{codewf:I18n {x:Static lcommon:Theme.Dark}}" />
        </ThemeVariantScope.Resources>
        <u:ThemeToggleButton Width="32" Height="28" IsThreeState="True" TargetScope="{Binding #TitleBarThemeScope}" ToolTip.Tip="{Binding SettingsPage.ThemeLabelText}" />
      </ThemeVariantScope>
      <ListBox Classes="titlePaletteSwatches" ItemsSource="{Binding SettingsPage.AccentColorOptions}" SelectedItem="{Binding SettingsPage.SelectedAccentColorOption, Mode=TwoWay}" AutoScrollToSelectedItem="False">
        <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="2" /></ItemsPanelTemplate></ListBox.ItemsPanel>
        <ListBox.ItemTemplate><DataTemplate x:DataType="vm:AccentColorOptionViewModel"><Ellipse Width="12" Height="12" Fill="{Binding AvaloniaBrush}" ToolTip.Tip="{Binding Title}" /></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <Button x:Name="TitleLanguageButton" Width="32" Height="28" MinHeight="0" Padding="6" Background="Transparent" BorderThickness="0" ToolTip.Tip="{Binding SettingsPage.LanguageLabelText}">
        <PathIcon Width="16" Height="16" Data="{StaticResource SemiIconLanguage}" />
        <Button.Flyout>
          <MenuFlyout>
            <MenuItem Header="{codewf:I18n {x:Static lcommon:Language.SimplifiedChinese}}" Command="{Binding SettingsPage.SelectLanguageCommand}" CommandParameter="{Binding SettingsPage.LanguageOptions[0]}" />
            <MenuItem Header="{codewf:I18n {x:Static lcommon:Language.English}}" Command="{Binding SettingsPage.SelectLanguageCommand}" CommandParameter="{Binding SettingsPage.LanguageOptions[1]}" />
          </MenuFlyout>
        </Button.Flyout>
      </Button>
    </StackPanel>
  </codewf:CodeWFWindow.RightContent>
  <Grid>
    <Grid RowDefinitions="Auto,*">
      <!-- 菜单栏：低频命令收纳 -->
      <Menu Grid.Row="0" FontSize="12.5" Height="34" BorderBrush="{DynamicResource StudioBorder}" BorderThickness="0,0,0,1">
        <MenuItem Header="{codewf:I18n {x:Static lcommon:Menu.File}}">
          <MenuItem
              Header="{codewf:I18n {x:Static lcommon:Menu.OpenImage}}"
              Command="{Binding OpenImageCommand}"
              HotKey="Ctrl+O" />
          <MenuItem
              Header="{codewf:I18n {x:Static lcommon:Menu.AddImages}}"
              Command="{Binding AddImagesCommand}"
              HotKey="Ctrl+Shift+O" />
          <Separator />
          <MenuItem
              Header="{codewf:I18n {x:Static lcommon:Menu.ExportImage}}"
              Command="{Binding PhotoShowExportDialogCommand}"
              HotKey="Ctrl+S" />
          <MenuItem
              Header="{codewf:I18n {x:Static lcommon:Actions.ExportZip}}"
              Command="{Binding BatchExportZipCommand}" />
          <Separator />
          <MenuItem
              Header="{codewf:I18n {x:Static lshell:Navigation.Settings}}"
              Command="{Binding NavigateSettingsCommand}">
            <MenuItem.Icon>
              <TextBlock Text="✓" IsVisible="{Binding IsSettingsPageActive}" />
            </MenuItem.Icon>
          </MenuItem>
          <Separator />
          <MenuItem Header="{codewf:I18n {x:Static lcommon:Menu.Exit}}" Click="OnExitClick" InputGesture="Alt+F4" />
        </MenuItem>
        <MenuItem Header="{codewf:I18n {x:Static lcommon:Menu.Edit}}">
          <MenuItem
              Header="{codewf:I18n {x:Static lphotostudio:Page.RotateLeft}}"
              Command="{Binding PhotoRotateLeftCommand}"
              />
          <MenuItem
              Header="{codewf:I18n {x:Static lphotostudio:Page.RotateRight}}"
              Command="{Binding PhotoRotateRightCommand}"
              />
          <MenuItem
              Header="{codewf:I18n {x:Static lphotostudio:Page.FlipHorizontal}}"
              Command="{Binding PhotoFlipCommand}"
              HotKey="Ctrl+H" />
          <Separator />
          <MenuItem
              Header="{codewf:I18n {x:Static lcommon:Actions.Reset}}"
              Command="{Binding PhotoResetCommand}"
              HotKey="Ctrl+R" />
        </MenuItem>
        <MenuItem Header="{codewf:I18n {x:Static lshell:Navigation.Workspace}}">
          <MenuItem
              Header="{codewf:I18n {x:Static lshell:Navigation.PhotoStudio}}"
              Command="{Binding NavigatePhotoStudioCommand}">
            <MenuItem.Icon>
              <TextBlock Text="✓" IsVisible="{Binding IsPhotoPageActive}" />
            </MenuItem.Icon>
          </MenuItem>
          <MenuItem Command="{Binding NavigateBatchProcessingCommand}">
            <MenuItem.Header>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <TextBlock Text="{codewf:I18n {x:Static lshell:Navigation.BatchProcessing}}" />
              </Grid>
            </MenuItem.Header>
            <MenuItem.Icon>
              <TextBlock Text="✓" IsVisible="{Binding IsBatchPageActive}" />
            </MenuItem.Icon>
          </MenuItem>
          <MenuItem
              Header="{codewf:I18n {x:Static lshell:Navigation.SmartCutout}}"
              Command="{Binding SmartCutoutCommand}" />
          <MenuItem IsEnabled="False">
            <MenuItem.Header>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <TextBlock Text="{codewf:I18n {x:Static lshell:Navigation.Toolbox}}" />
                <TextBlock
                    Grid.Column="1"
                    FontSize="10"
                    Foreground="{DynamicResource StudioMuted}"
                    Text="{codewf:I18n {x:Static lcommon:States.ComingSoon}}" />
              </Grid>
            </MenuItem.Header>
          </MenuItem>
          <Separator />
        </MenuItem>
        <MenuItem Header="{codewf:I18n {x:Static lcommon:Menu.View}}">
          <MenuItem
              Header="{codewf:I18n {x:Static lcommon:Menu.ZoomIn}}"
              Command="{Binding PhotoZoomCommand}"
              CommandParameter="+"
              />
          <MenuItem
              Header="{codewf:I18n {x:Static lcommon:Menu.ZoomOut}}"
              Command="{Binding PhotoZoomCommand}"
              CommandParameter="-"
              />
          <MenuItem
              Header="{codewf:I18n {x:Static lcommon:Menu.FitWindow}}"
              Command="{Binding PhotoZoomCommand}"
              CommandParameter="fit"
              HotKey="Ctrl+0" />
          <Separator />
          <MenuItem
              Header="{codewf:I18n {x:Static lcommon:Menu.ShowGuides}}"
              Command="{Binding PhotoToggleGuidesCommand}"
              HotKey="Ctrl+G"
              ToggleType="CheckBox"
              IsChecked="{Binding PhotoPage.ShowGuides, Mode=TwoWay}" />
          <MenuItem
              Header="{codewf:I18n {x:Static lcommon:Menu.CompareOriginal}}"
              Command="{Binding PhotoToggleCompareCommand}" />
          <Separator />
          <MenuItem Header="{codewf:I18n {x:Static lsettings:Labels.Theme}}">
            <MenuItem
                Header="{codewf:I18n {x:Static lcommon:Theme.Light}}"
                Command="{Binding SetThemeLightCommand}"
                ToggleType="Radio"
                GroupName="ThemeGroup"
                IsChecked="{Binding IsLightThemeChecked, Mode=OneWay}" />
            <MenuItem Header="{codewf:I18n {x:Static lcommon:Theme.Dark}}"
                Command="{Binding SetThemeDarkCommand}" ToggleType="Radio" GroupName="ThemeGroup"
                IsChecked="{Binding IsDarkThemeChecked, Mode=OneWay}" />
            <MenuItem
                Header="{codewf:I18n {x:Static lcommon:Theme.System}}"
                Command="{Binding SetThemeSystemCommand}"
                ToggleType="Radio"
                GroupName="ThemeGroup"
                IsChecked="{Binding IsSystemThemeChecked, Mode=OneWay}" />
          </MenuItem>
        </MenuItem>
        <MenuItem Header="{codewf:I18n {x:Static lcommon:Actions.Help}}">
          <MenuItem
              Header="{codewf:I18n {x:Static lcommon:Actions.Help}}"
              Command="{Binding PhotoPage.HelpCommand}"
              HotKey="F1" />
          <MenuItem
              Header="{codewf:I18n {x:Static lcommon:Menu.CheckUpdate}}"
              Command="{Binding CheckUpdateCommand}" />
          <Separator />
          <MenuItem Header="{codewf:I18n {x:Static lcommon:Menu.About}}" Command="{Binding ShowAboutCommand}" />
          <MenuItem
              Header="{codewf:I18n {x:Static lcommon:Menu.Repository}}"
              Command="{Binding SettingsPage.OpenRepositoryCommand}" />
        </MenuItem>
      </Menu>

      <views:MainView Grid.Row="1" />
    </Grid>

    <u:OverlayDialogHost
        HostId="{x:Static helpers:DialogHostIds.MainWindow}"
        OverlayMaskBrush="#730A1628"
        ZIndex="300">
      <u:OverlayDialogHost.DialogDataTemplates>
        <DataTemplate DataType="dialogVm:ExportDialogViewModel">
          <dialogViews:ExportDialogView />
        </DataTemplate>
      </u:OverlayDialogHost.DialogDataTemplates>
    </u:OverlayDialogHost>
  </Grid>
</codewf:CodeWFWindow>
