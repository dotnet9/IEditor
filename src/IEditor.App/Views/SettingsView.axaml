<UserControl
    x:Class="IEditor.App.Views.SettingsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:icons="using:IEditor.App.Icons"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shapes="using:Avalonia.Controls.Shapes"
    xmlns:u="using:Ursa.Controls"
    xmlns:vm="using:IEditor.App.ViewModels"
    x:CompileBindings="True"
    x:DataType="vm:SettingsViewModel"
    d:DesignHeight="860"
    d:DesignWidth="1320"
    mc:Ignorable="d">
  <UserControl.Styles>
    <Style Selector="ToggleButton.ie-swatch-button">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="BorderBrush" Value="{DynamicResource IEditorBorderStrongBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="ToggleButton.ie-swatch-button:checked">
      <Setter Property="BorderBrush" Value="{DynamicResource IEditorAccentBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*,Auto" RowSpacing="16" Margin="16">
    <Border
        Background="{DynamicResource IEditorSurfaceBrush}"
        BorderBrush="{DynamicResource IEditorBorderBrush}"
        BorderThickness="1"
        CornerRadius="8"
        Padding="12,10">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
        <StackPanel Spacing="2">
          <TextBlock Classes="ie-section-title" Text="{Binding Breadcrumb}" />
          <TextBlock Classes="ie-footnote" Text="{Binding Subtitle}" />
        </StackPanel>
        <Border
            Grid.Column="1"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Padding="10,4"
            Background="{DynamicResource IEditorAccentSoftBrush}"
            BorderBrush="{DynamicResource IEditorAccentTintBrush}"
            BorderThickness="1"
            CornerRadius="999">
          <TextBlock Classes="ie-footnote" Foreground="{DynamicResource IEditorAccentBrush}" Text="{Binding StatusText}" />
        </Border>
        <Button Classes="ie-icon-button" Grid.Column="2" Command="{Binding CheckUpdateCommand}" ToolTip.Tip="{Binding CheckUpdateText}">
          <shapes:Path Width="15" Height="15" Data="{x:Static icons:AppIcons.Help}" Fill="{DynamicResource IEditorTextSecondaryBrush}" />
        </Button>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1">
      <StackPanel Spacing="14">
        <Border Classes="ie-surface-card" Padding="0">
          <Grid RowDefinitions="Auto,*">
            <Border Padding="14,12" BorderBrush="{DynamicResource IEditorBorderBrush}" BorderThickness="0,0,0,1">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <shapes:Path Width="15" Height="15" Data="{x:Static icons:AppIcons.Settings}" Fill="{DynamicResource IEditorAccentBrush}" />
                <TextBlock Classes="ie-section-title" Text="{Binding AppearanceSectionTitle}" />
              </StackPanel>
            </Border>
            <StackPanel Grid.Row="1" Spacing="0" Margin="14">
              <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="4" Margin="0,6">
                <StackPanel>
                  <TextBlock Classes="ie-section-title" Text="{Binding ThemeLabelText}" />
                  <TextBlock Classes="ie-footnote" Text="{Binding ThemeDescriptionText}" />
                </StackPanel>
                <ListBox
                    Grid.Column="1"
                    Classes="ie-segment-list"
                    ItemsSource="{Binding ThemeOptions}"
                    SelectedItem="{Binding SelectedThemeOption, Mode=TwoWay}">
                  <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" Spacing="8" />
                    </ItemsPanelTemplate>
                  </ListBox.ItemsPanel>
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ThemeOptionViewModel">
                      <TextBlock Text="{Binding Title}" />
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>

              <Border Height="1" Background="{DynamicResource IEditorBorderBrush}" Margin="0,6" />

              <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="4" Margin="0,6">
                <StackPanel>
                  <TextBlock Classes="ie-section-title" Text="{Binding AccentColorLabelText}" />
                  <TextBlock Classes="ie-footnote" Text="{Binding AccentColorDescriptionText}" />
                </StackPanel>
                <ListBox
                    Grid.Column="1"
                    Classes="ie-swatch-list"
                    ItemsSource="{Binding AccentColorOptions}"
                    SelectedItem="{Binding SelectedAccentColorOption, Mode=TwoWay}">
                  <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" Spacing="8" />
                    </ItemsPanelTemplate>
                  </ListBox.ItemsPanel>
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:AccentColorOptionViewModel">
                      <Border Width="24" Height="24" CornerRadius="999" Background="{Binding AvaloniaColor}" BorderBrush="{DynamicResource IEditorBorderStrongBrush}" BorderThickness="1" ToolTip.Tip="{Binding Title}" />
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>

              <Border Height="1" Background="{DynamicResource IEditorBorderBrush}" Margin="0,6" />

              <Grid ColumnDefinitions="*,220" RowDefinitions="Auto,Auto" RowSpacing="4" Margin="0,6">
                <StackPanel>
                  <TextBlock Classes="ie-section-title" Text="{Binding LanguageLabelText}" />
                  <TextBlock Classes="ie-footnote" Text="{Binding LanguageDescriptionText}" />
                </StackPanel>
                <ListBox
                    Grid.Column="1"
                    Classes="ie-segment-list"
                    ItemsSource="{Binding LanguageOptions}"
                    SelectedItem="{Binding SelectedLanguageOption, Mode=TwoWay}">
                  <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" Spacing="8" />
                    </ItemsPanelTemplate>
                  </ListBox.ItemsPanel>
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:LanguageOptionViewModel">
                      <TextBlock Text="{Binding Title}" />
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>
            </StackPanel>
          </Grid>
        </Border>

        <Border Classes="ie-surface-card" Padding="0">
          <Grid RowDefinitions="Auto,*">
            <Border Padding="14,12" BorderBrush="{DynamicResource IEditorBorderBrush}" BorderThickness="0,0,0,1">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <shapes:Path Width="15" Height="15" Data="{x:Static icons:AppIcons.PhotoStudio}" Fill="{DynamicResource IEditorAccentBrush}" />
                <TextBlock Classes="ie-section-title" Text="{Binding ImageProcessingSectionTitle}" />
              </StackPanel>
            </Border>
            <StackPanel Grid.Row="1" Spacing="0" Margin="14">
              <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="4" Margin="0,6">
                <StackPanel>
                  <TextBlock Classes="ie-section-title" Text="{Binding DefaultDpiLabelText}" />
                  <TextBlock Classes="ie-footnote" Text="{Binding DefaultDpiDescriptionText}" />
                </StackPanel>
                <u:NumericIntUpDown Grid.Column="1" Minimum="72" Step="10" Value="{Binding DefaultDpi, Mode=TwoWay}" />
              </Grid>

              <Border Height="1" Background="{DynamicResource IEditorBorderBrush}" Margin="0,6" />

              <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="4" Margin="0,6">
                <StackPanel>
                  <TextBlock Classes="ie-section-title" Text="{Binding ShowGuidesLabelText}" />
                  <TextBlock Classes="ie-footnote" Text="{Binding ShowGuidesDescriptionText}" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowGuides, Mode=TwoWay}" />
              </Grid>

              <Border Height="1" Background="{DynamicResource IEditorBorderBrush}" Margin="0,6" />

              <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="4" Margin="0,6">
                <StackPanel>
                  <TextBlock Classes="ie-section-title" Text="{Binding EmbedSrgbLabelText}" />
                  <TextBlock Classes="ie-footnote" Text="{Binding EmbedSrgbDescriptionText}" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding EmbedSrgb, Mode=TwoWay}" />
              </Grid>

              <Border Height="1" Background="{DynamicResource IEditorBorderBrush}" Margin="0,6" />

              <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="4" Margin="0,6">
                <StackPanel>
                  <TextBlock Classes="ie-section-title" Text="{Binding ProcessingEngineLabelText}" />
                  <TextBlock Classes="ie-footnote" Text="{Binding ProcessingEngineDescriptionText}" />
                </StackPanel>
                <Border
                    Grid.Column="1"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Padding="10,4"
                    Background="{DynamicResource IEditorAccentSoftBrush}"
                    BorderBrush="{DynamicResource IEditorAccentTintBrush}"
                    BorderThickness="1"
                    CornerRadius="999">
                  <TextBlock Classes="ie-footnote" Foreground="{DynamicResource IEditorAccentBrush}" Text="{Binding ProcessingEngineBadgeText}" />
                </Border>
              </Grid>
            </StackPanel>
          </Grid>
        </Border>

        <Border Classes="ie-surface-card" Padding="0">
          <Grid RowDefinitions="Auto,*">
            <Border Padding="14,12" BorderBrush="{DynamicResource IEditorBorderBrush}" BorderThickness="0,0,0,1">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <shapes:Path Width="15" Height="15" Data="{x:Static icons:AppIcons.Export}" Fill="{DynamicResource IEditorAccentBrush}" />
                <TextBlock Classes="ie-section-title" Text="{Binding ExportingSectionTitle}" />
              </StackPanel>
            </Border>
            <StackPanel Grid.Row="1" Spacing="0" Margin="14">
              <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="4" Margin="0,6">
                <StackPanel>
                  <TextBlock Classes="ie-section-title" Text="{Binding DefaultSaveLocationLabelText}" />
                  <TextBlock Classes="ie-footnote" Text="{Binding DefaultSaveLocationDescriptionText}" />
                </StackPanel>
                <u:PathPicker
                    AllowMultiple="False"
                    Command="{Binding OpenSaveLocationCommand}"
                    DefaultFileExtension=""
                    SelectedPathsText="{Binding DefaultSaveLocation, Mode=TwoWay}"
                    UsePickerType="OpenFolder" />
              </Grid>

              <Border Height="1" Background="{DynamicResource IEditorBorderBrush}" Margin="0,6" />

              <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="4" Margin="0,6">
                <StackPanel>
                  <TextBlock Classes="ie-section-title" Text="{Binding DefaultFormatLabelText}" />
                  <TextBlock Classes="ie-footnote" Text="{Binding DefaultFormatDescriptionText}" />
                </StackPanel>
                <ListBox
                    Grid.Column="1"
                    Classes="ie-segment-list"
                    ItemsSource="{Binding FormatOptions}"
                    SelectedItem="{Binding SelectedFormatOption, Mode=TwoWay}">
                  <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" Spacing="8" />
                    </ItemsPanelTemplate>
                  </ListBox.ItemsPanel>
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:FormatOptionViewModel">
                      <TextBlock Text="{Binding Title}" />
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>

              <Border Height="1" Background="{DynamicResource IEditorBorderBrush}" Margin="0,6" />

              <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="4" Margin="0,6">
                <StackPanel>
                  <TextBlock Classes="ie-section-title" Text="{Binding DefaultQualityLabelText}" />
                  <TextBlock Classes="ie-footnote" Text="{Binding DefaultQualityDescriptionText}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                  <Slider Maximum="100" Minimum="60" Width="220" Value="{Binding DefaultQuality, Mode=TwoWay}" />
                  <Border Background="{DynamicResource IEditorSurface2Brush}" BorderBrush="{DynamicResource IEditorBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,3">
                    <TextBlock Classes="ie-footnote" FontFamily="Consolas" Text="{Binding DefaultQuality}" />
                  </Border>
                </StackPanel>
              </Grid>

              <Border Height="1" Background="{DynamicResource IEditorBorderBrush}" Margin="0,6" />

              <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" RowSpacing="4" Margin="0,6">
                <StackPanel Grid.ColumnSpan="2">
                  <TextBlock Classes="ie-section-title" Text="{Binding FilenameTemplateLabelText}" />
                  <TextBlock Classes="ie-footnote" Text="{Binding FilenameTemplateDescriptionText}" />
                </StackPanel>
                <TextBox Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding FilenameTemplate, Mode=TwoWay}" />
              </Grid>
            </StackPanel>
          </Grid>
        </Border>

        <Border Classes="ie-surface-card" Padding="0">
          <Grid RowDefinitions="Auto,*">
            <Border Padding="14,12" BorderBrush="{DynamicResource IEditorBorderBrush}" BorderThickness="0,0,0,1">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <shapes:Path Width="15" Height="15" Data="{x:Static icons:AppIcons.Help}" Fill="{DynamicResource IEditorAccentBrush}" />
                <TextBlock Classes="ie-section-title" Text="{Binding UpdateAboutSectionTitle}" />
              </StackPanel>
            </Border>
            <StackPanel Grid.Row="1" Spacing="0" Margin="14">
              <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="4" Margin="0,6">
                <StackPanel>
                  <TextBlock Classes="ie-section-title" Text="{Binding AutoCheckUpdateLabelText}" />
                  <TextBlock Classes="ie-footnote" Text="{Binding AutoCheckUpdateDescriptionText}" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoCheckUpdate, Mode=TwoWay}" />
              </Grid>

              <Border Height="1" Background="{DynamicResource IEditorBorderBrush}" Margin="0,6" />

              <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="4" Margin="0,6">
                <StackPanel>
                  <TextBlock Classes="ie-section-title" Text="{Binding CurrentVersionLabelText}" />
                  <TextBlock Classes="ie-footnote" Text="{Binding CurrentVersionDescriptionText}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                  <Border
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center"
                      Padding="10,4"
                      Background="{DynamicResource IEditorAccentSoftBrush}"
                      BorderBrush="{DynamicResource IEditorAccentTintBrush}"
                      BorderThickness="1"
                      CornerRadius="999">
                    <TextBlock Classes="ie-footnote" Foreground="{DynamicResource IEditorAccentBrush}" Text="{Binding VersionBadgeText}" />
                  </Border>
                  <Button Classes="ie-secondary-button" Command="{Binding CheckUpdateCommand}">
                    <TextBlock Text="{Binding CheckUpdateText}" />
                  </Button>
                </StackPanel>
              </Grid>

              <Border Height="1" Background="{DynamicResource IEditorBorderBrush}" Margin="0,6" />

              <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="4" Margin="0,6">
                <StackPanel>
                  <TextBlock Classes="ie-section-title" Text="{Binding OpenSourceRepositoryLabelText}" />
                  <TextBlock Classes="ie-footnote" Text="{Binding OpenSourceRepositoryDescriptionText}" />
                </StackPanel>
                <Button Grid.Column="1" Classes="ie-secondary-button" Command="{Binding OpenRepositoryCommand}">
                  <TextBlock Text="{Binding OpenRepositoryButtonText}" />
                </Button>
              </Grid>
            </StackPanel>
          </Grid>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Border
        Grid.Row="2"
        Background="{DynamicResource IEditorSurfaceBrush}"
        BorderBrush="{DynamicResource IEditorBorderBrush}"
        BorderThickness="1"
        CornerRadius="8"
        Padding="12,8">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
        <TextBlock Classes="ie-footnote" Text="{Binding StatusText}" />
        <TextBlock Grid.Column="2" Classes="ie-footnote" Text="{Binding VersionBadgeText}" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
