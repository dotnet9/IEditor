<Application
    x:Class="IEditor.App.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:IEditor.App.Views"
    xmlns:vm="using:IEditor.App.ViewModels"
    xmlns:semi="https://irihi.tech/semi"
    RequestedThemeVariant="Default">
  <Application.DataTemplates>
    <DataTemplate DataType="vm:PhotoStudioViewModel">
      <views:PhotoStudioView />
    </DataTemplate>
    <DataTemplate DataType="vm:BatchProcessingViewModel">
      <views:BatchProcessingView />
    </DataTemplate>
    <DataTemplate DataType="vm:SettingsViewModel">
      <views:SettingsView />
    </DataTemplate>
  </Application.DataTemplates>

  <Application.Styles>
    <semi:SemiTheme Locale="zh-CN" />
    <semi:UrsaSemiTheme Locale="zh-CN" />
    <semi:SemiPopupAnimations />
    <semi:ColorPickerSemiTheme />
    <StyleInclude Source="avares://IEditor.App/Styles/Index.axaml" />
    <StyleInclude Source="avares://IEditor.App/Styles/DialogOverlay.axaml" />
  </Application.Styles>
</Application>
