<#@ template debug="false" hostspecific="true" language="C#" #>
<#@ assembly name="System.Core" #>
<#@ assembly name="System.Text.Json" #>
<#@ assembly name="System.Memory" #>
<#@ assembly name="System.Runtime" #>
<#@ import namespace="System" #>
<#@ import namespace="System.IO" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="System.Text.Json" #>
<#@ output extension=".cs" #>
//------------------------------------------------------------------------------
// <auto-generated>
//     此文件由 T4 模板生成。
//     请修改 JSON 资源与模板，重新生成时将覆盖手工修改。
// </auto-generated>
//------------------------------------------------------------------------------
<#
    var templateDirectory = Path.GetDirectoryName(Host.TemplateFile)!;
    var jsonFilePath = Path.Combine(templateDirectory, "zh-CN.json");

    if (jsonFilePath is null)
    {
        throw new FileNotFoundException("JSON file not found in I18n template directory.");
    }

    using var doc = JsonDocument.Parse(File.ReadAllText(jsonFilePath));
    if (!doc.RootElement.TryGetProperty("Localization", out var localizationRoot)
        || localizationRoot.ValueKind != JsonValueKind.Object)
    {
        throw new InvalidDataException("The JSON file must contain a Localization object.");
    }

    foreach (var module in localizationRoot.EnumerateObject())
    {
        if (module.Value.ValueKind != JsonValueKind.Object)
        {
            continue;
        }

        var moduleName = SanitizeName(module.Name);
        WriteLine($"namespace Localization.{moduleName}");
        WriteLine("{");

        foreach (var group in module.Value.EnumerateObject())
        {
            if (group.Value.ValueKind != JsonValueKind.Object)
            {
                continue;
            }

            var groupName = SanitizeName(group.Name);
            WriteLine($"    public static class {groupName}");
            WriteLine("    {");

            foreach (var field in group.Value.EnumerateObject())
            {
                if (field.Value.ValueKind is JsonValueKind.Object or JsonValueKind.Array)
                {
                    continue;
                }

                WriteLine($"        public static readonly string {SanitizeName(field.Name)} = \"Localization.{moduleName}.{groupName}.{SanitizeName(field.Name)}\";");
            }

            WriteLine("    }");
            WriteLine(string.Empty);
        }

        WriteLine("}");
        WriteLine(string.Empty);
    }

    static string SanitizeName(string name)
    {
        if (string.IsNullOrWhiteSpace(name))
        {
            return "Unnamed";
        }

        var sanitized = new string(name.Where(c => char.IsLetterOrDigit(c) || c == '_').ToArray());
        if (sanitized.Length > 0 && char.IsDigit(sanitized[0]))
        {
            sanitized = "_" + sanitized;
        }

        return sanitized.Length == 0 ? "Unnamed" : sanitized;
    }
#>
