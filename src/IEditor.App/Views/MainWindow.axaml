<Window
    x:Class="IEditor.App.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:IEditor.App.Helpers"
    xmlns:dialogViews="using:IEditor.App.Views.Dialogs"
    xmlns:dialogVm="using:IEditor.App.ViewModels.Dialogs"
    xmlns:vm="using:IEditor.App.ViewModels"
    xmlns:views="using:IEditor.App.Views"
    xmlns:u="https://irihi.tech/ursa"
    x:CompileBindings="True"
    x:DataType="vm:MainViewModel"
    Background="{DynamicResource IEditorWindowBackgroundBrush}"
    ExtendClientAreaTitleBarHeightHint="42"
    ExtendClientAreaToDecorationsHint="True"
    FontFamily="Microsoft YaHei UI, Microsoft YaHei, Segoe UI"
    Height="860"
    Icon="/Assets/logo.ico"
    MinHeight="760"
    MinWidth="1100"
    Title="{Binding WindowTitle}"
    Width="1320"
    WindowDecorations="BorderOnly"
    WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid RowDefinitions="42,Auto,*">
      <!-- 自定义标题栏（品牌区） -->
      <Grid
          Background="{DynamicResource IEditorTitlebarBrush}"
          DoubleTapped="OnTitleBarDoubleTapped"
          PointerPressed="OnTitleBarPointerPressed">
        <StackPanel
            Margin="10,0,0,0"
            Orientation="Horizontal"
            Spacing="10"
            VerticalAlignment="Center">
          <Image
              Width="34"
              Height="34"
              Source="/Assets/logo.png" />
          <StackPanel VerticalAlignment="Center" Spacing="1">
            <TextBlock FontSize="15" FontWeight="Bold" Text="{Binding WindowTitle}" />
            <TextBlock
                Classes="ie-footnote"
                FontSize="11"
                Text="{Binding BrandSubtitle}" />
          </StackPanel>
        </StackPanel>
        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
          <Button
              Classes="ie-window-button"
              Click="OnMinimizeClick"
              ToolTip.Tip="最小化">
            <Path
                Classes="ie-icon"
                Width="11"
                Height="11"
                Data="M1.5,6 H10.5"
                Stroke="{Binding $parent[Button].Foreground}"
                StrokeThickness="1.2" />
          </Button>
          <Button
              Classes="ie-window-button"
              Click="OnMaximizeClick"
              ToolTip.Tip="最大化 / 还原">
            <Path
                Classes="ie-icon"
                Width="11"
                Height="11"
                Data="M2,2.5 H9.5 V10 H2 Z"
                Stroke="{Binding $parent[Button].Foreground}"
                StrokeThickness="1.2" />
          </Button>
          <Button
              Classes="ie-window-button close"
              Click="OnCloseClick"
              ToolTip.Tip="关闭">
            <Path
                Classes="ie-icon"
                Width="11"
                Height="11"
                Data="M2,2 L10,10 M10,2 L2,10"
                Stroke="{Binding $parent[Button].Foreground}"
                StrokeThickness="1.2" />
          </Button>
        </StackPanel>
      </Grid>

      <!-- 菜单栏：低频命令收纳 -->
      <Menu Grid.Row="1" FontSize="12.5">
        <MenuItem Header="文件">
          <MenuItem
              Header="打开图片…"
              Command="{Binding OpenImageCommand}"
              HotKey="Ctrl+O" />
          <MenuItem
              Header="添加图片…"
              Command="{Binding AddImagesCommand}"
              HotKey="Ctrl+Shift+O" />
          <Separator />
          <MenuItem
              Header="导出图片…"
              Command="{Binding PhotoShowExportDialogCommand}"
              HotKey="Ctrl+S" />
          <MenuItem
              Header="导出为 ZIP"
              Command="{Binding BatchExportZipCommand}" />
          <Separator />
          <MenuItem
              Header="设置"
              Command="{Binding NavigateSettingsCommand}">
            <MenuItem.Icon>
              <TextBlock Text="✓" IsVisible="{Binding IsSettingsPageActive}" />
            </MenuItem.Icon>
          </MenuItem>
          <Separator />
          <MenuItem Header="退出" Click="OnExitClick" InputGesture="Alt+F4" />
        </MenuItem>
        <MenuItem Header="编辑">
          <MenuItem
              Header="向左旋转"
              Command="{Binding PhotoRotateLeftCommand}"
              />
          <MenuItem
              Header="向右旋转"
              Command="{Binding PhotoRotateRightCommand}"
              />
          <MenuItem
              Header="水平镜像"
              Command="{Binding PhotoFlipCommand}"
              HotKey="Ctrl+H" />
          <Separator />
          <MenuItem
              Header="重置"
              Command="{Binding PhotoResetCommand}"
              HotKey="Ctrl+R" />
        </MenuItem>
        <MenuItem Header="工作区">
          <MenuItem
              Header="证件照处理"
              Command="{Binding NavigatePhotoStudioCommand}">
            <MenuItem.Icon>
              <TextBlock Text="✓" IsVisible="{Binding IsPhotoPageActive}" />
            </MenuItem.Icon>
          </MenuItem>
          <MenuItem Command="{Binding NavigateBatchProcessingCommand}">
            <MenuItem.Header>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <TextBlock Text="批量处理" />
              </Grid>
            </MenuItem.Header>
            <MenuItem.Icon>
              <TextBlock Text="✓" IsVisible="{Binding IsBatchPageActive}" />
            </MenuItem.Icon>
          </MenuItem>
          <MenuItem
              Header="智能抠图"
              Command="{Binding SmartCutoutCommand}" />
          <MenuItem IsEnabled="False">
            <MenuItem.Header>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <TextBlock Text="图片工具箱" />
                <TextBlock
                    Grid.Column="1"
                    FontSize="10"
                    Foreground="{DynamicResource IEditorTextTertiaryBrush}"
                    Text="即将上线" />
              </Grid>
            </MenuItem.Header>
          </MenuItem>
          <Separator />
        </MenuItem>
        <MenuItem Header="视图">
          <MenuItem
              Header="放大"
              Command="{Binding PhotoZoomCommand}"
              CommandParameter="+"
              />
          <MenuItem
              Header="缩小"
              Command="{Binding PhotoZoomCommand}"
              CommandParameter="-"
              />
          <MenuItem
              Header="适应窗口"
              Command="{Binding PhotoZoomCommand}"
              CommandParameter="fit"
              HotKey="Ctrl+0" />
          <Separator />
          <MenuItem
              Header="显示参考线"
              Command="{Binding PhotoToggleGuidesCommand}"
              HotKey="Ctrl+G"
              ToggleType="CheckBox"
              IsChecked="{Binding PhotoPage.ShowGuides, Mode=TwoWay}" />
          <MenuItem
              Header="原图对比（按住）"
              Command="{Binding PhotoToggleCompareCommand}" />
          <Separator />
          <MenuItem Header="主题">
            <MenuItem
                Header="浅色"
                Command="{Binding SetThemeLightCommand}"
                ToggleType="Radio"
                GroupName="ThemeGroup"
                IsChecked="{Binding IsLightThemeChecked, Mode=OneWay}" />
            <MenuItem IsEnabled="False">
              <MenuItem.Header>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                  <TextBlock Text="深色" />
                  <TextBlock
                      Grid.Column="1"
                      FontSize="10"
                      Foreground="{DynamicResource IEditorTextTertiaryBrush}"
                      Text="即将上线" />
                </Grid>
              </MenuItem.Header>
            </MenuItem>
            <MenuItem
                Header="跟随系统"
                Command="{Binding SetThemeSystemCommand}"
                ToggleType="Radio"
                GroupName="ThemeGroup"
                IsChecked="{Binding IsSystemThemeChecked, Mode=OneWay}" />
          </MenuItem>
        </MenuItem>
        <MenuItem Header="帮助">
          <MenuItem
              Header="帮助"
              Command="{Binding PhotoPage.HelpCommand}"
              HotKey="F1" />
          <MenuItem
              Header="检查更新…"
              Command="{Binding CheckUpdateCommand}" />
          <Separator />
          <MenuItem Header="关于 IEditor" IsEnabled="False" />
          <MenuItem
              Header="开源仓库"
              Command="{Binding SettingsPage.OpenRepositoryCommand}" />
        </MenuItem>
      </Menu>

      <views:MainView Grid.Row="2" />
    </Grid>

    <u:OverlayDialogHost
        HostId="{x:Static helpers:DialogHostIds.MainWindow}"
        OverlayMaskBrush="#730A1628"
        ZIndex="300">
      <u:OverlayDialogHost.DialogDataTemplates>
        <DataTemplate DataType="dialogVm:ExportDialogViewModel">
          <dialogViews:ExportDialogView />
        </DataTemplate>
      </u:OverlayDialogHost.DialogDataTemplates>
    </u:OverlayDialogHost>

    <!-- 窗口顶部品牌渐变线 -->
    <Border
        Height="3"
        VerticalAlignment="Top"
        Background="{DynamicResource IEditorAccentGradientBrush}"
        IsHitTestVisible="False"
        ZIndex="99" />
  </Grid>
</Window>
