<UserControl
    x:Class="IEditor.App.Views.SettingsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:icons="using:IEditor.App.Icons"
    xmlns:vm="using:IEditor.App.ViewModels"
    x:CompileBindings="True"
    x:DataType="vm:SettingsViewModel"
    >
  <UserControl.Styles>
    <Style Selector="ListBox.ie-segment-list ListBoxItem TextBlock.unselectable">
      <Setter Property="Opacity" Value="0.45" />
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="52,*,34">

    <!-- 顶栏 -->
    <Border Classes="ie-topbar">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="12">
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <TextBlock Classes="ie-crumb" Text="工作台 /" />
          <TextBlock Classes="ie-crumb-current" Text="{Binding Title}" />
        </StackPanel>
        <Border Grid.Column="1" Classes="ie-chip chip-green">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Ellipse Width="6" Height="6" Fill="{DynamicResource IEditorSuccessBrush}" />
            <TextBlock Text="{Binding StatusText}" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <!-- 内容 -->
    <Border Grid.Row="1" Background="{DynamicResource IEditorDotGridBrush}">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <Border MaxWidth="840" Margin="20" HorizontalAlignment="Center">
          <StackPanel Spacing="16">

            <!-- 外观 -->
            <Border Classes="ie-card">
              <StackPanel>
                <Border Classes="ie-card-header">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Path Classes="ie-icon" Width="15" Height="15" Data="{x:Static icons:AppIcons.Palette}" Stroke="{DynamicResource IEditorAccentBrush}" />
                    <TextBlock Classes="ie-section-title" Text="{Binding AppearanceSectionTitle}" />
                  </StackPanel>
                </Border>
                <Border Classes="ie-row">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                      <TextBlock Classes="ie-row-title" Text="{Binding ThemeLabelText}" />
                      <TextBlock Classes="ie-footnote" Text="{Binding ThemeDescriptionText}" />
                    </StackPanel>
                    <ItemsControl
                        Grid.Column="1"
                        ItemsSource="{Binding ThemeOptions}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Orientation="Horizontal" Spacing="4" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ThemeOptionViewModel">
                          <Button
                              Classes="ie-seg-opt"
                              Classes.on="{Binding IsSelected}"
                              IsEnabled="{Binding IsEnabled}"
                              MinWidth="74"
                              Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).SelectThemeCommand}"
                              CommandParameter="{Binding}"
                              Content="{Binding Title}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Grid>
                </Border>
                <Border Classes="ie-row">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                      <TextBlock Classes="ie-row-title" Text="{Binding AccentColorLabelText}" />
                      <TextBlock Classes="ie-footnote" Text="{Binding AccentColorDescriptionText}" />
                    </StackPanel>
                    <ListBox
                        Grid.Column="1"
                        Classes="ie-swatch-list"
                        ItemsSource="{Binding AccentColorOptions}"
                        SelectedItem="{Binding SelectedAccentColorOption, Mode=TwoWay}">
                      <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Orientation="Horizontal" Spacing="10" />
                        </ItemsPanelTemplate>
                      </ListBox.ItemsPanel>
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:AccentColorOptionViewModel">
                          <Border
                              Width="30"
                              Height="30"
                              CornerRadius="999"
                              Background="{Binding AvaloniaBrush}"
                              BorderBrush="{DynamicResource IEditorSwatchBorderBrush}"
                              BorderThickness="1"
                              ToolTip.Tip="{Binding Title}" />
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </Grid>
                </Border>
                <Border Classes="ie-row">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                      <TextBlock Classes="ie-row-title" Text="{Binding LanguageLabelText}" />
                      <TextBlock Classes="ie-footnote" Text="{Binding LanguageDescriptionText}" />
                    </StackPanel>
                    <ComboBox
                        Grid.Column="1"
                        MinWidth="160"
                        ItemsSource="{Binding LanguageOptions}"
                        SelectedItem="{Binding SelectedLanguageOption, Mode=TwoWay}">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:LanguageOptionViewModel">
                          <TextBlock Text="{Binding Title}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </Grid>
                </Border>
              </StackPanel>
            </Border>

            <!-- 图像处理 -->
            <Border Classes="ie-card">
              <StackPanel>
                <Border Classes="ie-card-header">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Path Classes="ie-icon" Width="15" Height="15" Data="{x:Static icons:AppIcons.LoadImage}" Stroke="{DynamicResource IEditorAccentBrush}" />
                    <TextBlock Classes="ie-section-title" Text="{Binding ImageProcessingSectionTitle}" />
                  </StackPanel>
                </Border>
                <Border Classes="ie-row">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                      <TextBlock Classes="ie-row-title" Text="{Binding DefaultDpiLabelText}" />
                      <TextBlock Classes="ie-footnote" Text="{Binding DefaultDpiDescriptionText}" />
                    </StackPanel>
                    <Border Grid.Column="1" Classes="ie-stepper">
                      <Grid ColumnDefinitions="Auto,Auto,Auto">
                        <Button Classes="ie-stepper-button" Height="32" Command="{Binding AdjustDefaultDpiCommand}" CommandParameter="-" Content="−" />
                        <TextBlock
                            Grid.Column="1"
                            Width="50"
                            VerticalAlignment="Center"
                            Classes="ie-mono"
                            TextAlignment="Center"
                            Text="{Binding DefaultDpi}" />
                        <Button Grid.Column="2" Classes="ie-stepper-button" Height="32" Command="{Binding AdjustDefaultDpiCommand}" CommandParameter="+" Content="＋" />
                      </Grid>
                    </Border>
                  </Grid>
                </Border>
                <Border Classes="ie-row">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                      <TextBlock Classes="ie-row-title" Text="{Binding ShowGuidesLabelText}" />
                      <TextBlock Classes="ie-footnote" Text="{Binding ShowGuidesDescriptionText}" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowGuides, Mode=TwoWay}" />
                  </Grid>
                </Border>
                <Border Classes="ie-row">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                      <TextBlock Classes="ie-row-title" Text="{Binding EmbedSrgbLabelText}" />
                      <TextBlock Classes="ie-footnote" Text="{Binding EmbedSrgbDescriptionText}" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding EmbedSrgb, Mode=TwoWay}" />
                  </Grid>
                </Border>
                <Border Classes="ie-row">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                      <TextBlock Classes="ie-row-title" Text="{Binding ProcessingEngineLabelText}" />
                      <TextBlock Classes="ie-footnote" Text="{Binding ProcessingEngineDescriptionText}" />
                    </StackPanel>
                    <Border Grid.Column="1" Classes="ie-chip chip-blue">
                      <TextBlock Text="{Binding ProcessingEngineBadgeText}" />
                    </Border>
                  </Grid>
                </Border>
              </StackPanel>
            </Border>

            <!-- 导出 -->
            <Border Classes="ie-card">
              <StackPanel>
                <Border Classes="ie-card-header">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Path Classes="ie-icon" Width="15" Height="15" Data="{x:Static icons:AppIcons.Export}" Stroke="{DynamicResource IEditorAccentBrush}" />
                    <TextBlock Classes="ie-section-title" Text="{Binding ExportingSectionTitle}" />
                  </StackPanel>
                </Border>
                <Border Classes="ie-row">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                      <TextBlock Classes="ie-row-title" Text="{Binding DefaultSaveLocationLabelText}" />
                      <TextBlock Classes="ie-mono" Foreground="{DynamicResource IEditorTextTertiaryBrush}" Text="{Binding DefaultSaveLocation}" />
                    </StackPanel>
                    <Button
                        Grid.Column="1"
                        Classes="ie-secondary-button"
                        Height="30"
                        Click="OnBrowseSaveLocationClick">
                      <TextBlock Text="{Binding BrowseText}" />
                    </Button>
                  </Grid>
                </Border>
                <Border Classes="ie-row">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                      <TextBlock Classes="ie-row-title" Text="{Binding DefaultFormatLabelText}" />
                      <TextBlock Classes="ie-footnote" Text="{Binding DefaultFormatDescriptionText}" />
                    </StackPanel>
                    <ListBox
                        Grid.Column="1"
                        Classes="ie-segment-list"
                        MinWidth="150"
                        ItemsSource="{Binding FormatOptions}"
                        SelectedItem="{Binding SelectedFormatOption, Mode=TwoWay}">
                      <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Orientation="Horizontal" Spacing="4" />
                        </ItemsPanelTemplate>
                      </ListBox.ItemsPanel>
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:FormatOptionViewModel">
                          <TextBlock Text="{Binding Title}" />
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </Grid>
                </Border>
                <Border Classes="ie-row">
                  <Grid ColumnDefinitions="*,240" ColumnSpacing="14">
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                      <TextBlock Classes="ie-row-title" Text="{Binding DefaultQualityLabelText}" />
                      <TextBlock Classes="ie-footnote" Text="{Binding DefaultQualityDescriptionText}" />
                    </StackPanel>
                    <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="10" VerticalAlignment="Center">
                      <Slider Maximum="100" Minimum="60" Value="{Binding DefaultQuality, Mode=TwoWay}" />
                      <Border Grid.Column="1" Classes="ie-chip">
                        <TextBlock Classes="ie-mono" Text="{Binding DefaultQuality}" />
                      </Border>
                    </Grid>
                  </Grid>
                </Border>
                <Border Classes="ie-row">
                  <Grid ColumnDefinitions="*,260" ColumnSpacing="14">
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                      <TextBlock Classes="ie-row-title" Text="{Binding FilenameTemplateLabelText}" />
                      <TextBlock Classes="ie-footnote" Text="{Binding FilenameTemplateDescriptionText}" />
                    </StackPanel>
                    <TextBox Grid.Column="1" CornerRadius="10" Text="{Binding FilenameTemplate, Mode=TwoWay}" />
                  </Grid>
                </Border>
              </StackPanel>
            </Border>

            <!-- 更新与关于 -->
            <Border Classes="ie-card">
              <StackPanel>
                <Border Classes="ie-card-header">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Path Classes="ie-icon" Width="15" Height="15" Data="{x:Static icons:AppIcons.Help}" Stroke="{DynamicResource IEditorAccentBrush}" />
                    <TextBlock Classes="ie-section-title" Text="{Binding UpdateAboutSectionTitle}" />
                  </StackPanel>
                </Border>
                <Border Classes="ie-row">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                      <TextBlock Classes="ie-row-title" Text="{Binding AutoCheckUpdateLabelText}" />
                      <TextBlock Classes="ie-footnote" Text="{Binding AutoCheckUpdateDescriptionText}" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoCheckUpdate, Mode=TwoWay}" />
                  </Grid>
                </Border>
                <Border Classes="ie-row">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                      <TextBlock Classes="ie-row-title" Text="{Binding CurrentVersionLabelText}" />
                      <TextBlock Classes="ie-footnote" Text="{Binding CurrentVersionDescriptionText}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <Border Classes="ie-chip chip-blue">
                        <TextBlock Text="{Binding VersionBadgeText}" />
                      </Border>
                    </StackPanel>
                  </Grid>
                </Border>
                <Border Classes="ie-row">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                      <TextBlock Classes="ie-row-title" Text="{Binding OpenSourceRepositoryLabelText}" />
                      <TextBlock Classes="ie-footnote" Text="{Binding OpenSourceRepositoryDescriptionText}" />
                    </StackPanel>
                    <Button Grid.Column="1" Classes="ie-secondary-button" Height="30" Command="{Binding OpenRepositoryCommand}">
                      <TextBlock Text="{Binding OpenRepositoryButtonText}" />
                    </Button>
                  </Grid>
                </Border>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>
      </ScrollViewer>
    </Border>

    <!-- 状态栏 -->
    <Border Grid.Row="2" Classes="ie-statusbar">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Ellipse Width="7" Height="7" Fill="{DynamicResource IEditorSuccessBrush}" />
          <TextBlock FontSize="12" Foreground="{DynamicResource IEditorTextSecondaryBrush}" Text="{Binding StatusText}" />
        </StackPanel>
        <TextBlock Grid.Column="2" VerticalAlignment="Center" Classes="ie-footnote" Text="{Binding VersionBadgeText}" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
